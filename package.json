{
  "name": "jnj-medtech-onboarding",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "3D onboarding journey for new J&J MedTech employees, delivered as a single portable HTML file.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
